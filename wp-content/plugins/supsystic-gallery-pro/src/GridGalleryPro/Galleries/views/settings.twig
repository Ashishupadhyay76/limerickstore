	{{ form.hidden('thumbnail[overlay][position]', settings.thumbnail.overlay.position) }}
    {{ form.hidden('icons[enabled]', settings.icons.enabled|default('false')) }}
	{{ form.hidden('thumbnail[overlay][enabled]', settings.thumbnail.overlay.enabled) }}
	{{ form.hidden('icons[overlay_color]', settings.captionBuilder.icons.bgColor | default(settings.icons.overlay_color)) }}

	{% if settings.captionBuilder.icons.bgColor is defined and settings.captionBuilder.icons.bgColor != '' %}
		{{ form.hidden('icons[overlay_enabled]', 'true') }}
	{% elseif settings.icons.overlay_enabled == 'true' %}
