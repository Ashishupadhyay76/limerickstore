{% embed '@galleries/shortcode/helpers.twig' with {'photo': photo, 'settings': settings} %}

	{% set tagsThatCanUseInCaptionBuilder = "<b><i><p><span><strong><em><del><h1><h2><h3><h4><h5><h6><ul><li><ol><dt><dl><dd><hr><br><img><table><td><tr><thead><tbody><th><tfoot><var><u><tt><title><sup><summary><sub><small><strike><samp><s><link><q><pre><param><menu><map><legend><label><kbd><ins><dfn><colgroup><col><code><cite><blockquote><caption><big><bdo><base><address><abbr><wbr><video><track><time><source><rp><progress><keygen><output>main><mark><meter><menuitem><header><footer><figure><figcaption><embed><dialog><details><canvas><bdi>" %}
	{% if settings.captionBuilder.icons.enable == '1' %}
		{% set tagsThatCanUseInCaptionBuilder = tagsThatCanUseInCaptionBuilder ~ '<a>' %}
	{% endif %}

	{% if settings.captionBuilder.icons.enable == '1' and settings.captionBuilder.icons.enableOldCompatibility == 1 %}
		{% set useFreePluginView = 'true' %}
        {% set settings = settings|merge({
            'icons': (settings.icons|merge({'enabled': 'true'})),
            'thumbnail': (settings.thumbnail|merge({'overlay': (settings.thumbnail.overlay|merge({'enabled': 'true'}))}))
        }) %}
	{% else %}
		{% set useFreePluginView = 'false' %}
	{% endif %}

	{% if settings.captionBuilder.background.enable != 1
		and settings.captionBuilder.title.enable != 1
		and settings.captionBuilder.description.enable != 1
		and settings.captionBuilder.icons.enable != '1'
	%}
		{% set saveNewPlugin = 0 %}
	{% else %}
		{% set saveNewPlugin = 1 %}
		{% if settings.captionBuilder.enabled is empty %}
			{% set settings = settings | merge({
				'captionBuilder': (settings.captionBuilder | merge({'enabled' : 1}))
			}) %}
		{% endif %}
	{% endif %}

	{% block ggFigureWidth %}
		{% if settings.area.grid == '2' or settings.area.grid == '4' %}
			width:auto;
		{% else %}
			width:{{ settings.area.photo_width ~ settings.area.photo_width_unit|replace(['px', '%']) }};
		{% endif %}
	{% endblock %}

	{% block a_attributes_href %}
		{% if settings.browserUrlTooltipHide != 1 %}
			href="{{ aHref|trim|htmlspecialchars_decode }}"
			target="{{ photo.attachment.target|default('_self') }}"
		{% endif %}
	{% endblock %}
	{% block a_attributes_class_set %}
		class="gg-link {{' '}} {{ aClass|trim }}
			{% if settings.displayFirstPhoto == 'on' and index > 0 %} hidden-item {% endif %}
			{% block ggMosaicHiddenItem %}
				{% if settings.area.grid == '4' and settings.isMosaicGgType == 1 %} hidden-item {% endif %}
			{% endblock %}
		"
	{% endblock %}

	{% block sggPopupLinkForDetailsButton %}
		{% if settings.box.type == '1' and settings.box.showLinkBtn == 1 %}
			data-rel="prettyPhoto[pp_gal]"
		{% else %}
			{{ parent() }}
		{% endif %}
	{% endblock %}

	{% block a_attributes %}
		{% set watermarkImageParams = {
			'width' : 0,
			'height' : 0,
			'attachmentId' : photo.attachment_id,
			'cropPosition' : (photo.attachment.cropPosition is not defined ? '' : photo.attachment.cropPosition),
		} %}
		{% if settings.box.showLinkBtn != 1 %}
			{% if photo.attachment.video is defined and photo.attachment.video is not empty %}
				{% set videoSource = 'other' %}
				{% if settings.box.type == '1' %}
					{#data-rel="prettyPhoto[pp_gal]"#}
					{% set youtube = {
						'www.'    : '',
						'http:'   : '',
						'https:'  : '',
						'youtu.be/': 'youtube.com/watch?v=',
						'embed/': 'watch?v=',
						'?rel=': '&rel='
					} %}
				{% endif %}
				{% set aHref %}
					{% if 'youtu' in photo.attachment.video %}
						{{ photo.attachment.video|replace(youtube) }}
						{% set videoSource = 'youtube' %}
					{% elseif 'vimeo.com' in photo.attachment.video %}
						{{ photo.attachment.video|preg_replace(vimeoPattern, vimeoReplace) ~ '?api=1' }}
						{% set videoSource = 'vimeo' %}
					{% else %}
						{{ photo.attachment.video|trim }}
					{% endif %}
				{% endset %}
				data-video-source="{{ videoSource }}"
				{# photobox plugin requirment #}
				rel="video"
				{#  #}
			{% else %}
				{% set aHref %}
					{% if is_ext_link == true %}
						{{ photo.attachment.external_link|force_http }}
						{% set link = true %}
					{% else %}
						{{ get_img_url_with_watermark(photo.attachment.url, watermarkImageParams) }}{% if photo.attachment.isRemoteImage != 1 %}{{ "?gid=" ~ gallery.id }}{% endif %}
					{% endif %}
				{% endset %}
			{% endif %}
		{% else %}
			{% if photo.attachment.external_link %}
				data-link-url="{{ photo.attachment.external_link|force_http }}"
			{% endif %}
			{% set aHref %}
				{{ get_img_url_with_watermark(photo.attachment.url, watermarkImageParams) ~ "?gid=" ~ gallery.id  }}
			{% endset %}
		{% endif %}
		{% if settings.attributes is defined and settings.attributes.enabled == 'true' %}
			{% set showAttributes = (settings.attributes.showAttributes == 1 and settings.box.type == '1') %}
			{% if settings.attributes.showFilter == 1 or showAttributes %}
				data-attributes="{{ photo.attributes|json_encode|e }}"
			{% endif %}
			{% if showAttributes and settings.attributes.showButtonLink == 1 %}
				{% if photo.attachment.buttonLinkTitle is defined and photo.attachment.buttonLinkTitle != "" %}
					data-buttonlink-title="{{ photo.attachment.buttonLinkTitle }}"
				{% endif %}
				{% if photo.attachment.buttonLinkUrl is defined and photo.attachment.buttonLinkUrl != "" %}
					data-buttonlink-url="{{ photo.attachment.buttonLinkUrl }}"
				{% endif %}
			{% endif %}
			{% if settings.attributes.showSearch == 1 %}
				data-keywords="{{ photo.attachment.imageKeywords|lower|default('') }}"
			{% endif %}
		{% endif %}
		{% if photo.attachment.external_link is not defined or photo.attachment.external_link is empty %}
			data-attachment-id="{{ photo.attachment.id }}"
		{% endif %}
		{{ parent() }}
		{% if photo.attachment.isRemoteImage == 1 and settings.box.type == '0' %}
			data-cbox-photo="1"
		{% endif %}
	{% endblock %}

	{% block figure_before %}
		{% if (saveNewPlugin == 0 or useFreePluginView == 'true') and settings.captionBuilder.isOnceUsed != 1 or settings.captionBuilder.enabled != 1 %}
			{% if settings.icons is not defined or settings.icons.enabled == 'false' %}
				<a {{ var_a_attributes }} >
			{% elseif settings.area.grid == 4 and index == 4 and settings.mosaic.use2Layout != 1 %}
				{% if settings.mosaic.images.allimages != 1 and settings.mosaic.images.showHiddenImageByClick != 1 %}
					<a {{ var_a_attributes }}>
				{% endif %}
			{% endif %}
		{% else %}
			{% if settings.captionBuilder.icons.enable != '1' %}
				{% if settings.browserUrlTooltipHide == 1 %}
					<div {{ var_a_attributes }} >
				{% else %}
					<a {{ var_a_attributes }} >
				{% endif %}
			{% elseif settings.area.grid == 4 and index == 4 and settings.mosaic.use2Layout != 1 %}
				{% if settings.mosaic.images.allimages != 1 and settings.mosaic.images.showHiddenImageByClick != 1 %}
					<a {{ var_a_attributes }}>
				{% endif %}
			{% endif %}
		{% endif %}
	{% endblock %}

	{% block figure_after %}
		{% if (saveNewPlugin == 0 or useFreePluginView == 'true') and settings.captionBuilder.isOnceUsed != 1 or settings.captionBuilder.enabled != 1 %}
			{% if settings.icons is not defined or settings.icons.enabled == 'false' %}
				</a>
			{% elseif settings.area.grid == 4 and index == 4 and settings.mosaic.use2Layout != 1 %}
				{% if settings.mosaic.images.allimages != 1 and settings.mosaic.images.showHiddenImageByClick != 1 %}
					</a>
				{% endif %}
			{% endif %}
		{% else %}
			{% if settings.captionBuilder.icons.enable != '1' %}
				{% if settings.browserUrlTooltipHide == 1 %}
					</div>
				{% else %}
					</a>
				{% endif %}
			{% elseif settings.area.grid == 4 and index == 4 and settings.mosaic.use2Layout != 1 %}
				{% if settings.mosaic.images.allimages != 1 and settings.mosaic.images.showHiddenImageByClick != 1 %}
					</a>
				{% endif %}
			{% endif %}
		{% endif %}
	{% endblock %}

	{# Categories #}
	{% set tags %}
		{% if settings.categories is defined and settings.categories.enabled == 'true' %}
			{{ photo.tags|join('|')|raw }}
		{% endif %}
	{% endset %}

	{% set youtube = {
		'www.'    : '',
		'http:'   : '',
		'https:'  : '',
		'youtu.be': 'youtube.com/embed',
		'watch?v=': 'embed/'
	} %}

	{% set vimeoPattern = ['{channels\/(.*)\/}', '{(http|https):\/\/vimeo\.com\/}'] %}
	{% set vimeoReplace = ['', '//player.vimeo.com/video/'] %}

    {% set galleryType %}
        {% block galleryTypeBlock %}
        	{% if (saveNewPlugin == 0 or useFreePluginView == 'true') and settings.captionBuilder.isOnceUsed != 1 or settings.captionBuilder.enabled != 1 %}
                {{ parent() }}
            {% else %}
                {% if settings.captionBuilder.background.enable == 1 %}
                    {% if settings.thumbnail.overlay.personal == 'true' %}
                        {{ photo.attachment.captionEffect|default(settings.thumbnail.overlay.effect) }}
                    {% else %}
                        {{ settings.thumbnail.overlay.effect }}
                    {% endif %}
                {% else %}
                    none
                {% endif %}
            {% endif %}
        {% endblock %}
    {% endset %}

	{% block figure_attributes %}
		data-tags="{{ tags|trim }}"
		data-id="{{ photo.id }}"
		{% if photo.attachment.linkedImages is defined and photo.attachment.linkedImages is not empty %}
			data-linked-images="{{ photo.attachment.linkedImages|json_encode|e }}"
			data-linked-image-title="{{ settings.box.linkedImageText|default('data-title') }}"
		{% endif %}
		{{ parent() }}
	{% endblock %}

	{% block figcaption_style %}
		{% if (saveNewPlugin == 0 or useFreePluginView == 'true') and settings.captionBuilder.isOnceUsed != 1 or settings.captionBuilder.enabled != 1 %}
			{{ parent() }}
		{% else %}
			{% if settings.captionBuilder.background.enable == 1 %}
				background-color:{{ settings.thumbnail.overlay.background }};
			{% endif %}
			padding: 0;
		{% endif %}
	{% endblock %}

	{% block figcaption_class %}
		{% if settings.area.grid == 4 and index == 4 and settings.mosaic.images.allimages != 1 and settings.mosaic.use2Layout != 1 %}
			sggDisplNone
		{% endif %}
	{% endblock %}

	{% block figcaption_attributes %}
		{{ parent() }}
	{% endblock %}

	{% block figcaption_wrap %}
		{% set watermarkImageParams = {
			'width' : 0,
			'height' : 0,
			'attachmentId' : photo.attachment_id,
			'cropPosition' : (photo.attachment.cropPosition is not defined ? '' : photo.attachment.cropPosition),
		} %}
		{% set prepareImgUrl = get_img_url_with_watermark(photo.attachment.url, watermarkImageParams) ~ "?gid=" ~ gallery.id  %}

		{% if (saveNewPlugin == 0 or useFreePluginView == 'true') and settings.captionBuilder.isOnceUsed != 1 or settings.captionBuilder.enabled != 1 %}
			{{ parent() }}
		{% endif %}
	{% endblock %}

	{% block figcaption_after_set_exif %}
		{% set exifText = _self.getExifText(settings, photo) %}
		{% if exifText | trim | length %}
			{% set ggCaptionText = exifText | trim %}
		{% endif %}
		<span style="{{ ggCaptionTextStyle }}">{{ ggCaptionText | raw }}</span>
	{% endblock %}

	{% block figcaption_after %}
		{% if (saveNewPlugin == 0 or useFreePluginView == 'true') and settings.captionBuilder.isOnceUsed != 1 or settings.captionBuilder.enabled != 1 %}
			{{ parent() }}
		{% endif %}
	{% endblock %}

	{% block previewImageUrlVar %}
		{% if photo.attachment.isNotRealAttachment == 1 %}
			{{ photo.attachment.url }}
		{% elseif photo.attachment.isRemoteImage == 1 %}
			{{ photo.attachment.thumbUrl|htmlspecialchars_decode }}
		{% else %}
			{% if settings.area.grid == 4 %}
				{{ get_attachment(photo.attachment.id, 0, 0, photo.attachment.cropPosition, settings.thumbnail.cropQuality|default('100')) }}
			{% else %}
				{{ get_attachment(photo.attachment.id, width, height, photo.attachment.cropPosition, settings.thumbnail.cropQuality|default('100')) }}
			{% endif %}
		{% endif %}
	{% endblock %}

	{% block image_attributes %}
		{{ parent() }}
		{% if (saveNewPlugin == 0 or useFreePluginView == 'true') and settings.captionBuilder.isOnceUsed != 1 or settings.captionBuilder.enabled != 1 %}
			{% if settings.thumbnail.overlay.enabled == 'true' and settings.thumbnail.overlay.imageOnHoverEnable == '1' and settings.thumbnail.overlay.personal == 'true' and photo.attachment.hoverCaptionImage is defined and photo.attachment.hoverCaptionImage != '' %}
				data-personal-hover-on-image="{{ photo.attachment.hoverCaptionImage }}"
			{% endif %}
		{% else %}
			{% if settings.captionBuilder.background.enable == 1 and settings.thumbnail.overlay.imageOnHoverEnable == '1' and settings.thumbnail.overlay.personal == 'true' and photo.attachment.hoverCaptionImage is defined and photo.attachment.hoverCaptionImage != '' %}
				data-personal-hover-on-image="{{ photo.attachment.hoverCaptionImage }}"
			{% endif %}
		{% endif %}

		{% set exifText = _self.getExifText(settings, photo) %}
		{% if exifText | trim | length %}
			data-exif-text="{{exifText | trim | raw}}"
		{% endif %}

		{% if photo.attachment.isRemoteImage == 1 %}
			data-gg-remote-image="1"
		{% endif %}
	{% endblock %}

	{% set captionBuilderTitleStyle %}
		{% if settings.thumbnail.overlay.foreground is defined and settings.thumbnail.overlay.foreground != '' %}
			color: {{ settings.thumbnail.overlay.foreground }};
		{% endif %}
		{% if settings.thumbnail.overlay.font_family != 'Default' %}
			font-family: '{{ settings.thumbnail.overlay.font_family }}';
		{% endif %}
		font-size:{{ settings.thumbnail.overlay.text_size }}{{ settings.thumbnail.overlay.text_size_unit|unitReplace(['px', '%', 'em']) }};
		{% if 'bold' in settings.thumbnail.overlay.fontStyle %}
			font-weight: 800;
		{% else %}
			font-weight: normal;
		{% endif %}
		{% if 'italic' in settings.thumbnail.overlay.fontStyle %}
			font-style: italic;
		{% else %}
			font-style: normal;
		{% endif %}
		{% if 'line' in settings.thumbnail.overlay.fontStyle %}
			text-decoration: underline;
		{% else %}
			text-decoration: none;
		{% endif %}
	{% endset %}

	{% set captionBuilderDescriptionStyle %}
		{% if settings.captionBuilder.description.fontColor is defined and settings.captionBuilder.description.fontColor != '' %}
			color: {{ settings.captionBuilder.description.fontColor }};
		{% endif %}
		{% if settings.captionBuilder.description.font_family != 'Default' %}
			font-family: '{{ settings.captionBuilder.description.font_family }}';
		{% endif %}
		font-size:{{ settings.captionBuilder.description.font_size }}{{ settings.captionBuilder.description.font_size_unit|unitReplace(['px', '%', 'em']) }};
		{% if 'bold' in settings.captionBuilder.description.fontStyle %}
			font-weight: 800;
		{% else %}
			font-weight: normal;
		{% endif %}
		{% if 'italic' in settings.captionBuilder.description.fontStyle %}
			font-style: italic;
		{% else %}
			font-style: normal;
		{% endif %}
		{% if 'line' in settings.captionBuilder.description.fontStyle %}
			text-decoration: underline;
		{% else %}
			text-decoration: none;
		{% endif %}
	{% endset %}

	{#===========Mosaic foto count============#}
	{% set mosaicLastImageNumberWrapperVar %}
		{% block mosaicLastImageNumberWrapper %}
			{% if mosaicParams is defined and mosaicParams.photoCountLeft > 0 %}
				<div class="gg-mosaic-photo-remain">
					<div class="gg-mosaic-pr-block">
						<div class="gg-mosaic-pr-text">+{{ mosaicParams.photoCountLeft }}</div>
					</div>
				</div>
			{% endif %}
		{% endblock %}
	{% endset %}
    {#===========Mosaic foto count============#}

	{% block oneGalleryImage %}
		{# some caption effects still as Older variant #}
		{% if (saveNewPlugin == 0 or useFreePluginView == 'true') and settings.captionBuilder.isOnceUsed != 1 or settings.captionBuilder.enabled != 1 %}
			{{ parent() }}
		{% else %}
			{% set ggCbTempOrderArr = {'top': null, 'center': null, 'bottom': null} %}
			{# prepare caption builder order array #}
			{% for ggCbIndex in ['title', 'description', 'icons'] %}
				{% if settings.captionBuilder[ggCbIndex].enable == '1' %}
					{% set ggCbPositionArr = settings.captionBuilder[ggCbIndex].position|split('_') %}
					{% if ggCbPositionArr|length > 1 %}
						{% set ggCbTempOrderArr = ggCbTempOrderArr|merge({ (ggCbPositionArr[1]) : ggCbIndex}) %}
					{% endif %}
				{% endif %}
			{% endfor %}

			{% set ggCbOrderArr = {} %}
			{#remove null values from order array (for backward compatibility) #}
			{% for ggCbKey, ggCbValue in ggCbTempOrderArr %}
				{% if ggCbValue != null %}
					{% set ggCbOrderArr = ggCbOrderArr| merge({(ggCbKey): ggCbValue}) %}
				{% endif %}
			{% endfor %}

			{# create caption builder table cells #}
			{% set ggCbTableCells %}
				{% for ggCbValue in ggCbTempOrderArr %}
					{% if ggCbValue != null %}
						{% set ggCbPositionArr = settings.captionBuilder[ggCbValue].position|split('_') %}
						{% if ggCbPositionArr|length > 1 %}
                            <div class="gg-caption-row  {{' '}}  {{ ggCbPositionArr[1] }}" style="
									text-align: {{ ggCbPositionArr[0] }};
									{#{% if ggCbOrderArr|length == 1 %}#}
										{#height: 100%;#}
									{#{% endif %}#}
									{% if settings.captionBuilder[ggCbValue].bgColor is defined and settings.captionBuilder[ggCbValue].bgColor != '' %}
										{% if settings.captionBuilder[ggCbValue].bgColorTransparency is defined %}
											background-color: {{ hex_to_rgba(settings.captionBuilder[ggCbValue].bgColor, (10 - settings.captionBuilder[ggCbValue].bgColorTransparency)/10) }};
										{% else %}
											background-color: {{ settings.captionBuilder[ggCbValue].bgColor }};
										{% endif %}
									{% endif %}
                                    {% if settings.captionBuilder[ggCbValue].height is defined and settings.captionBuilder[ggCbValue].height != '' %}
                                        height: {{ settings.captionBuilder[ggCbValue].height }};
									{# for polaroid effect #}
									{% elseif settings.thumbnail.overlay.personal == 'true'
										and photo.attachment.captionEffect == 'polaroid'
										or settings.thumbnail.overlay.effect  == 'polaroid'
									%}
										height: 33px;
									{% endif %}
								">
								{% set ggCbCellAttributes %}
									class="gg-caption-cell
										{#{% if ggCbPositionArr[1] == 'top' %}#}
											{#gg-caption-top#}
										{#{% elseif ggCbPositionArr[1] == 'center' %}#}
											{#gg-caption-middle#}
										{#{% else %}#}
											{#gg-caption-bottom#}
										{#{% endif %}#}
									" style="
										padding: {{ settings.captionBuilder[ggCbValue].paddings.top|default('0') }}px {{' '}}
											{{ settings.captionBuilder[ggCbValue].paddings.right|default('0') }}px {{' '}}
											{{ settings.captionBuilder[ggCbValue].paddings.bottom|default('0') }}px {{' '}}
											{{ settings.captionBuilder[ggCbValue].paddings.left|default('0') }}px;
									"
								{% endset %}

								<div {{ ggCbCellAttributes }}>
									{# check exif params#}
									{% set exifText = null %}
									{% if settings.exif.enabled == 1 and (photo.attachment.exif | length) %}
										{% set exifText = _self.getExifText(settings, photo) | trim %}
									{% endif %}

									{% if ggCbValue == 'icons' %}
										<div class="hi-icon-wrap {{' '}}  {{ settings.icons.effect[0:length-1] }} {{' '}}  {{ settings.icons.effect }}">
											{# Special for caption builder icons #}
											{% set watermarkImageParams = {
												'width' : 0,
												'height' : 0,
												'attachmentId' : photo.attachment_id,
												'cropPosition' : (photo.attachment.cropPosition is not defined ? '' : photo.attachment.cropPosition),
											} %}
											{% set prepareImgUrl = get_img_url_with_watermark(photo.attachment.url, watermarkImageParams) ~ "?gid=" ~ gallery.id  %}
											{# save parameters for show #}
											{% set showFewIconsVar = settings.icons.showFewIcons|default('default') %}
											{% set isShowVideoIcon = 0 %}
											{% if showFewIconsVar == 'default'
												or (
												showFewIconsVar == 'params'
													and settings.icons.isVideoIcon == '1'
												)
											%}
												{% set isShowVideoIcon = 1 %}
											{% endif %}

											{% set isShowLinkIcon = 0 %}
											{% if showFewIconsVar == 'default'
												or (
												showFewIconsVar == 'params'
													and settings.icons.isLinkIcon == '1'
												)
											%}
												{% set isShowLinkIcon = 1 %}
											{% endif %}

											{% set isShowPopupIcon = 0 %}
											{% if showFewIconsVar == 'default'
												or (
												showFewIconsVar == 'params'
													and settings.icons.isPopupIcon == '1'
												)
											%}
												{% set isShowPopupIcon = 1 %}
											{% endif %}

											{% set isShowDownloadIcon = 0 %}
											{% if showFewIconsVar == 'params' and settings.icons.isDownloadIcon == '1'%}
												{% set isShowDownloadIcon = 1 %}
											{% endif %}

											{% if settings.box.showLinkBtn != 1 %}
												{% if photo.attachment.video is defined and photo.attachment.video is not empty %}
													{% if isShowVideoIcon == 1 %}
														{% set videoUrl %}
															{% if 'youtu' in photo.attachment.video %}
																{{ photo.attachment.video|replace(youtube) }}
																{% set videoSource = 'youtube' %}
															{% elseif 'vimeo.com' in photo.attachment.video %}
																{{ photo.attachment.video|preg_replace(vimeoPattern, vimeoReplace) ~ '?api=1' }}
																{% set videoSource = 'vimeo' %}
															{% else %}
																{{ photo.attachment.video|trim }}
															{% endif %}
														{% endset %}

														{% if settings.captionBuilder.icons.videoFontAwesomeClass is not empty %}
															{% set videoIcon = settings.captionBuilder.icons.videoFontAwesomeClass %}
														{% else %}
															{% set videoIcon = 'youtu' in photo.attachment.video ? 'fa-youtube-play' : 'fa-vimeo' %}
														{% endif %}

														{% set iconStyle %}
															{% if settings.icons.margin is not empty %}
																margin-left:{{ settings.icons.margin }}px;
																margin-right:{{ settings.icons.margin }}px;
															{% endif %}
														{% endset %}

														<a href="{{ videoUrl|trim }}" data-id="gg-{{ gallery.id }}-{{ photo.id }}"
															{% if settings.disableImageTitle != 1 %}
																title="{{ aTitle|trim }}"
															{% endif %}
															class="hi-icon fa gg-video {{' '}} {{ videoIcon }} {{' '}} {% if settings.box.type == '2' %} pbox{% endif %}"
															style="{{ iconStyle|trim }}"
															data-video-source="{{ videoSource }}"
																{% if settings.box.type == '1' %}
																	data-rel="prettyPhoto[pp_gal]"
																{% else %}
																	rel="video"
																{% endif %}
														>
															{#Watch the video {{ photo.attachment.caption }}#}
														</a>
													{% endif %}
												{% endif %}

												{% if photo.attachment.external_link is defined and photo.attachment.external_link is not empty %}
													{% if isShowLinkIcon == 1 %}
														{% if settings.captionBuilder.icons.linkFontAwesomeClass is not empty %}
															{% set externalLinkIcon = settings.captionBuilder.icons.linkFontAwesomeClass %}
														{% else %}
															{% set externalLinkIcon = 'fa-link' %}
														{% endif %}

														<a
															{% if settings.disableImageTitle != 1 %}
																title="{{ aTitle|trim }}"
															{% endif %}
															data-id="gg-{{ gallery.id }}-{{ photo.id }}"
															href="{% if settings.openByLink == 'on' %} {{ prepareImgUrl }} {% else %} {{ photo.attachment.external_link }} {% endif %}"
															target="{{ photo.attachment.target|default('_self') }}"
															class="hi-icon fa {{' '}} {{ externalLinkIcon }} {{' '}}
															{% if settings.box.type == '2' and settings.openByLink == 'on' %} pbox{% endif %}">
														</a>
													{% endif %}
												{% endif %}
											{% endif %}

											{% if isShowPopupIcon == 1 %}
												<a
													{% if settings.disableImageTitle != 1 %}
														title="{{ aTitle|trim }}"
													{% endif %}
													data-id="gg-{{ gallery.id }}-{{ photo.id }}"
													href="{{ prepareImgUrl }}"
													{% if photo.attachment.external_link is not defined or photo.attachment.external_link is empty %}
														data-attachment-id="{{ photo.attachment.id }}"
													{% endif %}
													class="hi-icon gg-colorbox fa {{' '}} {{ settings.captionBuilder.icons.popupFontAwesomeClass | default('fa-expand') }} {{' '}}
													{% if settings.box.type == '2' %} pbox{% endif %}"
													{% if settings.box.showLinkBtn == 1 %}data-link-url="{{ photo.attachment.external_link }}"{% endif %}
													{% if settings.box.type == '1' %} data-rel="prettyPhoto[pp_gal]" {% endif %}>
												</a>
											{% endif %}

											{% if isShowDownloadIcon == 1 %}
												{% if (photo.attachment.external_link is not defined or photo.attachment.external_link is empty) and photo.attachment.id is not empty %}
												<a
													{% if settings.disableImageTitle != 1 %}
														title="{{ aTitle|trim }}"
													{% endif %}
													href="{{ prepareImgUrl }}"
													data-attachment-id="{{ photo.attachment.id }}"
													class="hi-icon gg-download-button fa {{' '}} {{ settings.captionBuilder.icons.downloadFontAwesomeClass | default('fa-download') }}"
													>
												</a>
												{% endif %}
											{% endif %}
										</div>
									{% elseif ggCbValue == 'title' %}
										<span {% if settings.rtl == true %}dir="rtl" class="ggRtlClass"{% endif %} style="{{ captionBuilderTitleStyle }}">
											{% if (exifText | trim | length) and settings.exif.showExifAsCaption == 1 %}
												{{exifText | raw}}
											{% elseif photo.attachment.caption is not empty %}
												{% if settings.captionBuilder.captionhtml.enable == '1' %}
													{{ photo.attachment.caption | raw }}
												{% else %}
													{{ photo.attachment.caption | striptags(tagsThatCanUseInCaptionBuilder) | raw }}
												{% endif %}

											{% else %}
												{{ photo.attachment.title }}
											{% endif %}
										</span>
									{% elseif ggCbValue == 'description' %}
										<span {% if settings.rtl == true %}dir="rtl" class="ggRtlClass"{% endif %} style="{{ captionBuilderDescriptionStyle }}">
											{% if (exifText | trim | length) and settings.exif.showExifAsDescription == 1 %}
												{{exifText | raw }}
											{% elseif photo.attachment.captionDescription is not empty %}
												{{ photo.attachment.captionDescription | striptags(tagsThatCanUseInCaptionBuilder) | raw }}
											{% endif %}
										</span>
									{% endif %}
								</div>
							</div>
						{% endif %}
					{% else %}
						<div class="gg-caption-row disabled"
							{# for polaroid effect #}
							{% if settings.thumbnail.overlay.personal == 'true'
								and photo.attachment.captionEffect == 'polaroid'
								or settings.thumbnail.overlay.effect  == 'polaroid'
							%}
								style="height: 0px;"
							{% endif %}
						>
							<div class="gg-caption-cell"></div>
						</div>
					{% endif %}
				{% endfor %}
			{% endset %}

			{% set captionTableAttr %}
				style="
					{# for polaroid effect #}
					{% if settings.thumbnail.overlay.personal == 'true'
						and photo.attachment.captionEffect == 'polaroid'
						or settings.thumbnail.overlay.effect  == 'polaroid'
					%}
						height: 0
					{% endif %}
				"
				data-gid="{{ gallery.id }}"
			{% endset %}

			{{ var_figure_before }}
				<FIGURE {{ var_figure_attributes }} >
					<div class="crop {% if settings.thumbnail.shadow.overlay == '1' and settings.use_shadow == '1' %} image-overlay {% endif %}"
					 style="
						{% if settings.area.grid == '0' or settings.area.grid == '3' %}
							width:{{ settings.area.photo_width ~ settings.area.photo_width_unit|unitReplace(['px', '%']) }};
							height:{{ settings.area.photo_height ~ settings.area.photo_height_unit|unitReplace(['px', '%']) }};
							overflow:hidden;
						{% endif %}
					">
					<img {{ var_image_attributes }} />
					</div>
					{{ mosaicLastImageNumberWrapperVar }}
					{% if settings.area.grid == 4 and index == 4 and (settings.mosaic.images.allimages != 1 and settings.mosaic.images.showHiddenImageByClick != 1) and settings.mosaic.use2Layout != 1 %}
						{# empty caption for Mosaic Gallery and empty params (allimages and showHiddenImageByClick) #}
					{% else %}
						<FIGCAPTION {{ var_figcaption_attributes }}	>
							<div class="gg-caption-table" {{ captionTableAttr }}>{{ ggCbTableCells }}</div>
						</FIGCAPTION>
					{% endif %}
					{{ var_figcaption_after }}
				</FIGURE>
			{{ var_figure_after }}
		{% endif %}
	{% endblock %}

	{% block mosaicFigcaptionWrapper %}
		{% if settings.area.grid == 4 and index == 4 and (settings.mosaic.images.allimages != 1 and settings.mosaic.images.showHiddenImageByClick != 1) and settings.mosaic.use2Layout != 1 %}
			{# empty caption for Mosaic Gallery and empty params (allimages and showHiddenImageByClick) #}
		{% else %}
			<FIGCAPTION {{ var_figcaption_attributes }}	>
				<div class="grid-gallery-figcaption-wrap"
						style="
						{% if settings.icons is not defined or settings.icons.enabled == 'false' %}
								vertical-align:{{ settings.thumbnail.overlay.position }};
						{% endif %}">
					{{ var_figcaption_wrap }}
				</div>
			</FIGCAPTION>
		{% endif %}
		{{ var_figcaption_after }}
	{% endblock %}

	{% block ggImageCaptionEntry %}
		{% set exifText = null %}
		{% if settings.exif.enabled == 1 and (photo.attachment.exif | length) and settings.exif.showExifAsCaption == 1 %}
			{% set exifText = _self.getExifText(settings, photo) | trim %}
		{% endif %}

		{% if exifText | trim | length %}
			<div class="gg-image-caption fitvidsignore {% if settings.rtl == true %}ggRtlClass{% endif %}" {% if settings.rtl == true %}dir="rtl"{% endif %} style="font-size:{{ settings.thumbnail.overlay.text_size }}{{ settings.thumbnail.overlay.text_size_unit|unitReplace(['px', '%', 'em']) }};">
				<object type="none/none">
					{{exifText | raw}}
				</object>
			</div>
		{% else %}
			{{ parent() }}
		{% endif %}
	{% endblock %}

	{% macro getExifText(settings, photo) %}
		{% set exifText = null %}
		{% if settings.exif.enabled == 1 and photo.attachment.exif | length
			and (settings.exif.showExifAsCaption == 1  or settings.exif.showExifAsDescription == 1 or settings.exif.showExifOnLightoboxImage == 1)
		%}
			{% if settings.exif.cameraName == 1 and (photo.attachment.exif['cameraMake'] | trim) %}
				{% set exifText = exifText ~ "<i class='fa fa-camera' aria-hidden='true'></i> " ~ photo.attachment.exif['cameraMake'] ~ ' ' %}
			{% endif %}
			{% if settings.exif.cameraModel == 1 and (photo.attachment.exif['camera'] | trim) %}
				{% set exifText = exifText ~ "<i class='fa fa-camera-retro' aria-hidden='true'></i> " ~ photo.attachment.exif['camera'] ~ ' ' %}
			{% endif %}
			{% if settings.exif.aperture == 1 and (photo.attachment.exif['aperture'] | trim) %}
				{% set exifText = exifText ~ "<i class='fa fa-chrome' aria-hidden='true'></i> " ~ photo.attachment.exif['aperture'] ~ ' ' %}
			{% endif %}
			{% if settings.exif.exposureBias == 1 and (photo.attachment.exif['exposureBiasValue'] | trim) %}
				{% set exifText = exifText ~ "<i class='fa fa-calendar-plus-o' aria-hidden='true'></i> " ~ photo.attachment.exif['exposureBiasValue'] ~ ' ' %}
			{% endif %}
			{% if settings.exif.flash == 1 and (photo.attachment.exif['flash'] | trim) %}
				{% set exifText = exifText ~ "<i class='fa fa-bolt' aria-hidden='true'></i> " ~ photo.attachment.exif['flash'] ~ ' ' %}
			{% endif %}
			{% if settings.exif.focalLength == 1 and (photo.attachment.exif['focal_length'] | trim) %}
				{% set exifText = exifText ~ "<i class='fa fa-crop' aria-hidden='true'></i> " ~ photo.attachment.exif['focal_length'] ~ ' ' %}
			{% endif %}
			{% if settings.exif.iso == 1 and (photo.attachment.exif['iso'] | trim) %}
				{% set exifText = exifText ~ ' <strong>ISO</strong>:' ~ photo.attachment.exif['iso'] ~ ' ' %}
			{% endif %}
			{% if settings.exif.shutterSpeed == 1 and (photo.attachment.exif['shutterSpeed'] | trim) %}
				{% set exifText = exifText ~ "<i class='fa fa-clock-o' aria-hidden='true'></i> " ~ photo.attachment.exif['shutterSpeed'] ~ ' ' %}
			{% endif %}
			{% if settings.exif.location == 1 and (photo.attachment.exif['location'] | trim) %}
				{% set exifText = exifText ~ "<i class='fa fa-map-marker' aria-hidden='true'></i> " ~ photo.attachment.exif['location'] ~ ' ' %}
			{% endif %}
		{% endif %}
		{{exifText | raw}}
	{% endmacro %}
{% endembed %}
