					{ 'style': 'width: auto;', 'id': 'thumbnailOverlayFontFamily' }
				),
				'thumbnailOverlayFontFamilyRow'
			)}}

			{# Title font size #}
			{{ form.row(translate('Font size'),
				form.input(
					'number',
					'thumbnail[overlay][text_size]',
					settings.thumbnail.overlay.text_size,
					{ 'style': { 'width': '70px'}, 'id' : 'thumbnailOverlayTextSize', 'pattern':'[0-9]' }
