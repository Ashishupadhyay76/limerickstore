{% extends '@galleries/settings.twig' %}
{% import '@galleries/settings.twig' as parentSett %}

{% block galleryTypeSelectorItems %}

	{% set galleryTypeObj = [
		{'value':'0', 'title':'Fixed'},
		{'value':'1', 'title':'Vertical'},
		{'value':'2', 'title':'Horizontal'},
		{'value':'3', 'title':'Fixed Columns'},
		{'value':'4', 'title':'Mosaic'},
	] %}

	{{ form.row(translate('Gallery Type'),
		form.selectWithElem(
			'area[grid]',
			galleryTypeObj,
			settings.area.grid,
			{ 'style': 'width: auto;' }
		),
		'grid-type', 'gallery-types', 'columns'
	)}}

	{% set mosaicLayouts = [
		{'value':'0', 'title':'default (2+3)'},
		{'value':'1', 'title':'multi-column'},
		{'value':'2', 'title':'one row (1+2)'},
		{'value':'3', 'title':'one row (1+4)'},
	] %}

	{{ form.row(translate('Mosaic layout'),
		form.selectWithElem(
			'mosaic[use2Layout]',
			mosaicLayouts,
			settings.mosaic.use2Layout,
			{ 'id': 'sggMosaicLayout', 'style': 'width: auto;' }
		),
		'mosaic-layout',
		null, 'sggMosaicLayoutRow'
	)}}
	{{ form.row(translate('Number of columns'),
		form.input(
			'number',
			'mosaic[countColumns]',
			settings.mosaic.countColumns >=3 ? settings.mosaic.countColumns : 4,
			{ 'style': { 'width': '70px'}, 'id' : 'sggMosaicCountColumns', 'pattern':'[3-12]'}
		),
		'mosaic-count-columns',
		null,
		'sggMosaicCountColumnsRow'
	)}}
{% endblock %}

{% set settings = gallery.settings %}
{% set id = gallery.settings_id %}
{% set tagsThatCanUseInCaptionBuilder = "<b><i><p><span><strong><em><del><h1><h2><h3><h4><h5><h6><ul><li><ol><dt><dl><dd><hr><br><img><table><td><tr><thead><tbody><th><tfoot><var><u><tt><title><sup><summary><sub><small><strike><samp><s><link><q><pre><param><menu><map><legend><label><kbd><ins><dfn><colgroup><col><code><cite><blockquote><caption><big><bdo><base><address><abbr><wbr><video><track><time><source><rp><progress><keygen><output>main><mark><meter><menuitem><header><footer><figure><figcaption><embed><dialog><details><canvas><bdi>" %}

{% block mosaicImagesCount %}

    <div id="gg-mosaic-image-count-wrapper">
        <table class="form-table" name="area" id="gg-mosaic-image-count">
            <thead>
			{{ form.row(translate('Images count to display'), '', 'img-count-header', 1) }}
            </thead>
            <tbody>

            {{ form.row(
				translate('Display all images'),
				form.checkbox(
					'mosaic[images][allimages]',
					1,
					{'id' : 'mosaicDisplayAllImg',} | merge(settings.mosaic.images.allimages == 1 ? {'checked':'checked'} : {})
				),
				'mosaic-display-all-images',
				null,
				'mosaic-display-all-images-row'
            ) }}

            {# form.row(
            translate('Images count'),
            form.input('number', 'mosaic[images][count]', settings.mosaic.images.count | default(5), {'min' : 5}),
            'mosaic-images-count',
            '',
            'mosaic-images-count-row'
            ) #}

            {{ form.row(
				translate('Show hidden images by click'),
            	form.checkbox(
					'mosaic[images][showHiddenImageByClick]',
					1,
					{'id': 'mosaicShowHiddenImages'} | merge(settings.mosaic.images.showHiddenImageByClick == 1 ? {'checked':'checked'} : {})
				),
				'mosaic-show-hidden-images',
				null,
				'mosaic-show-hidden-images-row'
            ) }}

            </tbody>
        </table>
        <div class="separator"></div>
    </div>






{% endblock %}

{% if settings.captionBuilder.icons.enable == '1' %}
	{% set tagsThatCanUseInCaptionBuilder = tagsThatCanUseInCaptionBuilder ~ '<a>' %}
{% endif %}

{% block icon_wrap_item_class %}
	fa {{' '}} {{ settings.captionBuilder.icons.popupFontAwesomeClass | default('fa-expand') }}
{% endblock %}

{% if settings.captionBuilder.background.enable != 1
	and settings.captionBuilder.title.enable != 1
    and settings.captionBuilder.description.enable != 1
    and settings.captionBuilder.icons.enable != '1'
%}
    {% set saveNewPlugin = 0 %}
{% else %}
    {% set saveNewPlugin = 1 %}
	{% if settings.captionBuilder.enabled is empty %}
		{% set settings = settings | merge({
			'captionBuilder': (settings.captionBuilder | merge({'enabled' : 1}))
		}) %}
	{% endif %}
{% endif %}

{% if settings.captionBuilder.icons.enable == '1' and settings.captionBuilder.icons.enableOldCompatibility == 1 %}
	{% set useFreePluginView = 'true' %}
	{% set settings = settings|merge({
		'icons': (settings.icons|merge({'enabled': 'true'})),
		'thumbnail': (settings.thumbnail|merge({'overlay': (settings.thumbnail.overlay|merge({'enabled': 'true'}))}))
	}) %}
{% else %}
	{% set useFreePluginView = 'false' %}
{% endif %}

{% set iconsRowEntryVal %}
	<div class="sggCbEntrySpan hi-icon-wrap {{' '}}  {{ settings.icons.effect[0:length-1] }} {{' '}}  {{ settings.icons.effect }}">
		{% if settings.captionBuilder.icons.videoFontAwesomeClass is not empty %}
			{% set videoIcon = settings.captionBuilder.icons.videoFontAwesomeClass %}
		{% else %}
			{% set videoIcon = 'youtu' in gallery.photos[0].attachment.video ? 'fa-youtube-play' : 'fa-vimeo' %}
		{% endif %}
		{% set iconStyle %}
			{% if settings.icons.margin is not empty %}
				margin-left:{{ settings.icons.margin }}px;
				margin-right:{{ settings.icons.margin }}px;
			{% endif %}
		{% endset %}

		<a href="#" class="hi-icon gg-icon-video fa {{' '}} {{ videoIcon }}"
			style="{{ iconStyle|trim }}"></a>

		{% if settings.captionBuilder.icons.linkFontAwesomeClass is not empty %}
			{% set externalLinkIcon = settings.captionBuilder.icons.linkFontAwesomeClass %}
		{% else %}
			{% set externalLinkIcon = 'fa-link' %}
		{% endif %}

		<a href="#" class="hi-icon gg-icon-link fa {{' '}} {{ externalLinkIcon }}"
			style="{{ iconStyle|trim }}">
		</a>

		<a href="#" class="hi-icon gg-icon-popup fa {{' '}} {{ settings.captionBuilder.icons.popupFontAwesomeClass | default('fa-expand') }}"
			style="{{ iconStyle|trim }}">
		</a>

		<a href="#" class="hi-icon gg-icon-download fa {{' '}} {{ settings.captionBuilder.icons.downloadFontAwesomeClass | default('fa-download') }}"
			style="{{ iconStyle|trim }}">
		</a>
	</div>
{% endset %}

{% macro selected(actual, expected) %}
    {% if actual == expected %}selected="selected"{% endif %}
{% endmacro %}

{% macro label(label, for) %}
    <label for="{{ for }}">{{ label }}</label>
{% endmacro %}

{% macro addRow(post, index) %}
    <script type="text/javascript">
        jQuery(document).ready(function($) {

            var row = {
                id: '{{ post.id }}',
                image: '{{ post.photo }}',
                author: '{{ post.author }}',
                title: '{{ post.title }}',
                comments: '{{ post.comments }}',
                type: '{{ post.type }}',
                date: '{{ post.date }}'
            };

            jQuery("#ui-jqgrid-htable").jqGrid('addRowData', {{ post.id }}, row);
        });
    </script>
{% endmacro %}

{% block proHiddenSettings %}
	{{ form.hidden('captionBuilder[isOnceUsed]', settings.captionBuilder.isOnceUsed == 1 ? 1 : saveNewPlugin, {'id': 'captionBuilderOnceUsed'}) }}
{% endblock %}

{% block captionSettingsType %}

	<table class="form-table" name="captionSettingsType">
		<tbody>
			{{ form.row(translate('Use Caption Builder'),
				form.radio(
					'captionBuilder[enabled]',
					1,
					{'id':'ggShowUserCaptionBuilder', 'class': 'ggUserCaptionBuilderCl'} | merge(settings.captionBuilder.enabled == 1 ? {'checked':'checked'} : {})
				) ~
				f.label(
					translate('Enable'),
					'ggShowUserCaptionBuilder'
				) ~
				form.radio(
					'captionBuilder[enabled]',
					0,
					{'id':'ggHideUserCaptionBuilder', 'class': 'ggUserCaptionBuilderCl'} | merge(settings.captionBuilder.enabled != 1 ? {'checked':'checked'} : {})
				) ~
				f.label(
					translate('Disable'),
					'ggHideUserCaptionBuilder'
				),
				'useCaptionBuilder',
				true
			)}}
		</tbody>
	</table>
	{{ form.hidden(
		'thumbnail[overlay][imageOnHover]',
		settings.thumbnail.overlay.imageOnHover,
		{'id': 'ggImageOnHoverPath'}
	)}}
{% endblock %}

{% block proCaptionAndIconSettings %}
	{# caption builder Title position compatibility #}
	{% if settings.captionBuilder.title.position is defined %}
		{% set titleTablePosition = settings.captionBuilder.title.position %}
	{% else %}
		{% if settings.thumbnail.overlay.position == 'top' %}
			{% set titleFreePosition = 'top' %}
		{% elseif settings.thumbnail.overlay.position == 'bottom' %}
			{% set titleFreePosition = 'bottom' %}
		{% else %}
			{% set titleFreePosition = 'center' %}
		{% endif %}

		{% if settings.thumbnail.overlay.text_align == 'left' %}
			{% set titleFreeTextAlign = 'left' %}
		{% elseif settings.thumbnail.overlay.text_align == 'right' %}
			{% set titleFreeTextAlign = 'right' %}
		{% else %}
			{% set titleFreeTextAlign = 'center' %}
		{% endif %}

		{% set titleTablePosition = titleFreeTextAlign ~ '_' ~ titleFreePosition %}
	{% endif %}

	{% set iconsTablePosition = settings.captionBuilder.icons.position %}
	{% set descriptionTablePosition = settings.captionBuilder.description.position %}

