		{% if gallery.photos[0].attachment.caption is not empty %}
			{{ gallery.photos[0].attachment.caption | striptags(tagsThatCanUseInCaptionBuilder) | raw }}
		{% else %}
			{{ gallery.photos[0].attachment.title }}
		{% endif %}
	{% endset %}
	{% set ggPreviewDescriptionRowHtml %}
		{% if gallery.photos[0].attachment.captionDescription is not empty %}
			{{ gallery.photos[0].attachment.captionDescription | striptags(tagsThatCanUseInCaptionBuilder) | raw }}
		{% endif %}
	{% endset %}

	{{ form.hidden('captionBuilder[title][entry]', ggPreviewTitleRowHtml, {'id': 'ggPreviewTitleRowHtmlInp'}) }}
	{{ form.hidden('captionBuilder[description][entry]', ggPreviewDescriptionRowHtml, {'id': 'ggPreviewDescrRowHtmlInp'}) }}

	{# Caption builder Background #}
    <table class="form-table sgg-caption-builder sggSettDisplNone" name="captions-builder-background">
        <thead>

		{{ form.row(translate('Background'),
			form.checkbox(
				'captionBuilder[background][enable]',
