{
  "permissions": {
    "deny": [
      "Read(./wp-config.php)",
      "Read(./.env)",
      "Read(./**/*.sql)",
      "Read(./**/*.sql.gz)",
      "Read(./wp-content/uploads/**)",
      "Bash(*wp-config.php*)",
      "Bash(*.env*)",
      "Bash(git push*master*)",
      "Bash(git push*main*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(rm -rf*)"
    ]
  }
}
