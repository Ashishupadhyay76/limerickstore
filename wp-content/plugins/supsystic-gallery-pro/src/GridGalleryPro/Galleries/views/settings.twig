{% block modals %}
    {{ parent() }}

    {% set borderStyles = {
        'none': 'None',
        'solid': 'Solid',
        'dotted': 'Dotted',
        'dashed': 'Dashed',
        'double': 'Double',
        'groove': 'Groove',
        'ridge': 'Ridge',
        'inset': 'Inset',
        'outset': 'Outset',
    } %}

    <div class="social-setup-dialog" title="{{ translate('Social setup') }}" hidden>
        <table class="form-table" name="cats-preset-editor" data-gallery-id="{{ gallery.id }}" id="social-setup-dialog-table">
            {% for network in networks %}
                {{ form.row(translate(network.name),
                    form.input('text', 'custom_network[' ~ network.class ~ ']', settings.custom_network[network.class],  {'data-property': network.class, 'style' : 'width: 100%', 'placeholder' : 'https://'}))
                }}
            {% endfor %}
        </table>
    </div>

    <div class="buttons-edit-preset-dialog" title="{{ translate('Buttons preset editor for Paginations, Categories and Load More buttons') }}">
        <div class="buttons-edit-preset-dialog__left-col">
            <p>This is how buttons will look like</p>
            <div class="preview-button-container">
                <a id="preview-button">Button</a>
            </div>
            <div id="buttons-presets-list" data-presets-data="{{ buttonsPresets|json_encode()|e }}" data-init-preset="{{ settings.buttons|json_encode()|default([])|e }}">
                <p>Presets list</p>
            </div>
        </div>
        <div class="buttons-edit-preset-dialog__right-col">
            <table class="form-table" name="cats-preset-editor" data-gallery-id="{{ gallery.id }}" id="buttons-preset">

                {{ form.row(translate('Custom class'),
					form.input('text', 'buttons[class]', settings.buttons.class,  {'data-property':'class'}), 'tcb-cust-class') }}

                {{ form.row(translate('Text color'),
					form.input('text', 'buttons[color]', settings.buttons.color, {'class':'gg-color-picker-buttons', 'data-property':'color'}), 'tcb-text-color') }}

                {{ form.row(translate('Background color'),
					form.input('text', 'buttons[backgroundColor]', settings.buttons.backgroundColor, {'class':'gg-color-picker-buttons', 'data-property':'backgroundColor'}), 'tcb-background-color') }}

                {{ form.row(translate('Font family'),
					form.selectv('buttons[fontFamily]', fontList, settings.buttons.fontFamily, {'data-property':'fontFamily'}), 'tcb-font-family') }}

                {{ form.row(translate('Font size'),
					form.input('number', 'buttons[fontSize]', settings.buttons.fontSize, {'data-property':'fontSize'}), 'tcb-font-size') }}

                {{ form.row(translate('Font weight'),
					form.select('buttons[fontWeight]', {'normal':'Normal', 'bold':'Bold'}, settings.buttons.fontWeight, {'data-property':'fontWeight'}), 'tcb-font-weight') }}

                {{ form.row(translate('Vertical padding'),
					form.input('number', 'buttons[paddingV]', settings.buttons.paddingV, {'data-property':'paddingV'}), 'tcb-vertical-padding') }}

                {{ form.row(translate('Horizontal padding'),
					form.input('number', 'buttons[paddingH]', settings.buttons.paddingH, {'data-property':'paddingH'}), 'tcb-horizontal-padding') }}

                {{ form.row(translate('Border style'),
					form.select('buttons[borderStyle]', borderStyles, settings.buttons.borderStyle, {'data-property':'borderStyle'}), 'tcb-border-style') }}

                {{ form.row(translate('Border width'),
					form.input('number', 'buttons[borderWidth]', settings.buttons.borderWidth, {'data-property':'borderWidth'}), 'tcb-border-width') }}

                {{ form.row(translate('Border color'),
					form.input('text', 'buttons[borderColor]', settings.buttons.borderColor, {'class':'gg-color-picker-buttons', 'data-property':'borderColor'}), 'tcb-border-color') }}

                {{ form.row(translate('Border radius'),
					form.input('number', 'buttons[borderRadius]', settings.buttons.borderRadius, {'data-property':'borderRadius'}), 'tcb-border-radius') }}

            </table>
        </div>
    </div>



