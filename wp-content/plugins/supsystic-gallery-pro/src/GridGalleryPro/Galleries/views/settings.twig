{% block preload %}
	<table class="form-table" name="preload" id="gg-anl-preloader">
        <thead>
            {% set preloadEnabled = settings.preload.enabled|default('true') == 'true' %}
            {{ form.row(translate('Gallery Loader'),
                form.radio('preload[enabled]', 'true', {'id':'preload-enable'}|merge(preloadEnabled ? {'checked':'checked'} : {})) ~
                f.label(translate('Enable'), 'preload-enable') ~
                form.radio('preload[enabled]', 'false', {'id':'preload-disable'}|merge(preloadEnabled ? {} : {'checked':'checked'})) ~
                f.label(translate('Disable'), 'preload-disable'), 'preload', true) }}
        </thead>

        <tbody>
            {% set preloadColor = settings.preload.background|default("#0073AA") %}
            {{ form.row(translate('Background color'),
                form.text('preload[background]', preloadColor, {'class':'gg-color-picker', 'id': 'preloadColor'}), 'preload-background') }}

            {% set plIconName = settings.preload.icon_name|default("default") %}
            {% set pldIconItems = settings.preload.icon_items|default("0") %}

            {% if plIconName == "default" %}
                {% set piconImg %}
                    <div class="gallery-loading">
                        <div class="blocks">
                            <div class="block"></div>
                            <div class="block"></div>
                            <div class="block"></div>
                            <div class="block"></div>
                        </div>
                    </div>
                {% endset %}
            {% else %}
                {% set piconImg %}
                    <div class="gallery-loading">
                        <div class="la-{{ plIconName }}" style="color: {{ preloadColor }}">
                        {% for i in 1..pldIconItems %}
                            <div></div>
                        {% endfor %}
                        </div>
                    </div>
                {% endset %}
            {% endif %}

            {{ form.row(translate('Choose Icon'),
                form.button('buttons-preload-icon', 'Choose Icon', {'class': 'button button-primary', 'id': 'choosePreicon'})
                ~ form.hidden('preload[icon_name]', plIconName, {'id':'plIconName'})
                ~ form.hidden('preload[icon_items]', pldIconItems, {'id':'pldIconItems'})
                ~ piconImg, 'preloadIconPlace') }}
        </tbody>
    </table>
    <div class="separator"></div>
{% endblock %}

